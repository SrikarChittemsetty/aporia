# Base URL of the Python API (api/main.py). Leave unset to build the offline
# demo, which answers from the bundled corpus in public/demo-data.json.
#
# Local development against a running backend:
#   NEXT_PUBLIC_APORIA_API=http://127.0.0.1:8080
#
# Deployed:
#   NEXT_PUBLIC_APORIA_API=https://api.aporia.srikarchittemsetty.com
#
# NEXT_PUBLIC_ prefixed values are inlined into the client bundle at build time
# and are readable by anyone loading the page. Only put public URLs here — the
# Anthropic key stays server-side, on the backend, and never reaches this app.
NEXT_PUBLIC_APORIA_API=
